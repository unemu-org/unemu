# SeaBIOS rel-1.17.0 fragment; olddefconfig supplies the pinned defaults.

# The emulated-machine target retains ISA ATA and CMOS RAM-size fallbacks.
CONFIG_QEMU=y
# A fixed 128 KiB image fits the board's E0000h-FFFFFh firmware window.
CONFIG_ROM_SIZE=128
# Headless console output uses the serial port supplied through fw_cfg.
CONFIG_SERCON=y
# Keep POST diagnostics on the emulator debug port (402h by default).
CONFIG_DEBUG_IO=y
# Keep diagnostics enabled so DEBUG_IO remains effective.
CONFIG_DEBUG_LEVEL=1
# Machine-provided boot order replaces the interactive menu and its wait.
# CONFIG_BOOTMENU is not set
# A single-CPU ISA board has no local APIC for MP-table generation to probe.
# CONFIG_MPTABLE is not set
# There is no PCI interrupt router or PIIX chipset to describe.
# CONFIG_PIRTABLE is not set
# This board supplies no SMBIOS platform description.
# CONFIG_SMBIOS is not set
# There is no ACPI chipset or power-management interface; no IASL is needed.
# CONFIG_ACPI is not set
# No ACPI tables need the firmware-table relocation loader.
# CONFIG_FW_ROMFILE_LOAD is not set
# No ACPI DSDT or virtio-mmio devices need the separate DSDT parser.
# CONFIG_ACPI_PARSE is not set
# The ISA board has no ACPI power-management timer.
# CONFIG_PMTIMER is not set
# There is no USB host controller on this ISA board.
# CONFIG_USB is not set
# No PCI configuration interface is offered to guest software.
# CONFIG_PCIBIOS is not set
# There is no chipset implementing System Management Mode.
# CONFIG_USE_SMM is not set
# There is no TPM or measured-boot interface.
# CONFIG_TCGBIOS is not set
# The board has no ACPI S3 sleep state to resume from.
# CONFIG_S3_RESUME is not set
# This firmware targets the ISA board, not a Xen HVM guest.
# CONFIG_XEN is not set
# A 386 has no memory-type range registers.
# CONFIG_MTRR_INIT is not set
# A 386 has no timestamp counter; use the PIT timing path.
# CONFIG_TSC_TIMER is not set
# No integrated PCI graphics chipset needs special VGA callbacks.
# CONFIG_VGAHOOKS is not set

# There is no PCI AHCI controller; retain the default ISA ATA driver instead.
# CONFIG_AHCI is not set
# There is no PCI SD-card host controller.
# CONFIG_SDCARD is not set
# There is no virtio block transport on this ISA board.
# CONFIG_VIRTIO_BLK is not set
# There is no virtio SCSI transport on this ISA board.
# CONFIG_VIRTIO_SCSI is not set
# There is no paravirtual PCI SCSI controller.
# CONFIG_PVSCSI is not set
# There is no AMD PCI SCSI controller.
# CONFIG_ESP_SCSI is not set
# There is no LSI PCI SCSI controller.
# CONFIG_LSI_SCSI is not set
# There is no MegaRAID PCI controller.
# CONFIG_MEGASAS is not set
# There is no MPT Fusion PCI controller.
# CONFIG_MPT_SCSI is not set
# There is no PCI NVMe controller.
# CONFIG_NVME is not set
