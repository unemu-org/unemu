# Logs
logs
ci-logs/
*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo
*.sw?
*~

# Local-only
*.local
.envrc.local

# direnv cache (Nix flake users)
.direnv/

# Skills: .agents/skills/ is vendored (committed). .claude/skills/ holds symlinks into
# it, generated on demand by scripts/skills-bootstrap.sh — not committed.
.claude/skills/

# --- Rust ---
target/
# Golden-test scratch / captured traces
/tmp-golden/
# User-created game disks, journals and machine-file overrides.
/machines/local/

# --- Vendored test data (fetched/built, never committed) ---
# test386 CPU-test ROM: the upstream clone and the assembled image are rebuilt
# from a pinned commit by vendor/test386/fetch.sh, not checked in.
/vendor/test386/test386.asm/
/vendor/test386/test386.bin
# Kiselev 8088_bios (Xi8088 config): the upstream clone, the assembled BIOS and
# its source archive are rebuilt from a pinned commit by
# vendor/kiselev-bios/fetch.sh, not checked in.
/vendor/kiselev-bios/8088_bios
/vendor/kiselev-bios/bios-xi8088.bin
/vendor/kiselev-bios/bios-xi8088-atreset.bin
/vendor/kiselev-bios/kiselev-bios-*-src.tar
/vendor/kiselev-bios/build/
# SeaBIOS ISA configuration: pinned source cache, exports and built firmware.
/vendor/seabios/src/
/vendor/seabios/build/
/vendor/seabios/bios-1.17.0-isa.bin
# FreeDOS boot floppy: the fetched release archives, the boot-sector source clone,
# and the assembled 1.44 MB and 1.2 MB images are rebuilt by vendor/freedos/fetch.sh, not
# checked in (FreeDOS is GPL; used unmodified as a read-only fixture).
/vendor/freedos/build/
/vendor/freedos/freedos.img
/vendor/freedos/freedos-1200.img
/vendor/freedos/freedos-tools-1200.img
# FreeDOS 1.4 Floppy Edition: the edition's disks, the release documents, the
# licence index and the deterministic source archive, written by
# vendor/freedos/fetch-floppy-1.4.sh (its downloads stay under build/).
/vendor/freedos/floppy-1.4/
# XTIDE Universal BIOS AT option ROM: pinned download, source export, the
# padded/checksummed images and their source archive are rebuilt by
# vendor/xtide-universal-bios/fetch.sh, not checked in.
/vendor/xtide-universal-bios/build/
/vendor/xtide-universal-bios/ide_at-r638-8k.bin
/vendor/xtide-universal-bios/ide_xtp-r638-ata1f0-8k.bin
/vendor/xtide-universal-bios/xtide-universal-bios-*-src.tar
# Open VGA BIOS (LGPL), its INT 10h probe floppy and their source archive:
# built by Nix from a pinned release by vendor/vgabios/fetch.sh, never committed.
/vendor/vgabios/build/
/vendor/vgabios/vgabios-std.bin
/vendor/vgabios/int10-probe-1200.img
/vendor/vgabios/vgabios-*-src.tar
# Open AT BIOS (GPL, the unemu fork of 8088_bios) and its source archive:
# built by Nix from a pinned release by vendor/unemu-at-bios/fetch.sh, never
# committed.
/vendor/unemu-at-bios/build/
/vendor/unemu-at-bios/bios-unemu-at.bin
/vendor/unemu-at-bios/unemu-at-bios-*-src.tar
# FAT16 hard-disk data fixture: rebuilt offline by vendor/hdd/build.sh.
/vendor/hdd/build/
/vendor/hdd/fat16.img
# Open AT protected-mode test floppy: assembled from the committed source by
# vendor/at-pm-test/build.sh.
/vendor/at-pm-test/build/
/vendor/at-pm-test/at-pm-test-1200.img

# repoctx local index (generated)
.repoctx/

# Beads / Dolt files (added by bd init)
.dolt/
.beads/**/*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Local x86jit override for development (see backlog/docs/dev-setup.md § CPU core)
.cargo/config.toml

# Proprietary firmware remains user-supplied; only its instructions are tracked.
/vendor/user-roms/*
!/vendor/user-roms/README.md

# Local-only Lo-tech driver fixture; no redistribution rights.
/vendor/ltemm/LTEMM.EXE
/vendor/ltemm/.extract.*/
/vendor/ltemm/*.zip

# Third-party shareware: archives, installation floppies, vendor-text extras and
# anything else a user puts here (unpacked files, other spellings, symlinks)
# stay local. Only the scripts and their READMEs are tracked.
/vendor/shareware/**
!/vendor/shareware/**/
!/vendor/shareware/common.sh
!/vendor/shareware/*/fetch.sh
!/vendor/shareware/*/README.md
