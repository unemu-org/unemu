{
  "$defs": {
    "attachment.any": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.any"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "documentation"
          ]
        },
        "title": {
          "$ref": "#/$defs/line128"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "extra"
      ],
      "type": "object"
    },
    "attachment.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.ibm-pc"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "documentation"
          ]
        },
        "title": {
          "$ref": "#/$defs/line128"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "extra"
      ],
      "type": "object"
    },
    "crc32": {
      "description": "8 lower-case hexadecimal digits",
      "pattern": "^[0-9a-f]{8}$",
      "type": "string"
    },
    "date": {
      "description": "a calendar date YYYY-MM-DD",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "type": "string"
    },
    "db-id": {
      "additionalProperties": false,
      "properties": {
        "db": {
          "enum": [
            "no-intro",
            "redump",
            "tosec",
            "mame"
          ]
        },
        "name": {
          "$ref": "#/$defs/line"
        },
        "set": {
          "$ref": "#/$defs/line"
        }
      },
      "required": [
        "db",
        "set",
        "name"
      ],
      "type": "object"
    },
    "digest": {
      "description": "sha256: and 64 lower-case hexadecimal digits",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "extra.any": {
      "additionalProperties": false,
      "properties": {
        "dos_name": {
          "minLength": 1,
          "type": "string"
        },
        "file_name": {
          "$ref": "#/$defs/file-name"
        },
        "from": {
          "$ref": "#/$defs/reference"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "document",
            "archive",
            "executable",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "file_name",
        "kind",
        "from"
      ],
      "type": "object"
    },
    "extra.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "dos_name": {
          "minLength": 1,
          "type": "string"
        },
        "file_name": {
          "$ref": "#/$defs/file-name"
        },
        "from": {
          "$ref": "#/$defs/reference"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "document",
            "archive",
            "executable",
            "other"
          ]
        }
      },
      "required": [
        "id",
        "file_name",
        "kind",
        "from"
      ],
      "type": "object"
    },
    "fat-step.any": {
      "additionalProperties": false,
      "properties": {
        "fat": {
          "$ref": "#/$defs/reference"
        },
        "format": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line"
        },
        "order": {
          "enum": [
            "name",
            "listed"
          ]
        },
        "serial": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "$ref": "#/$defs/local-time"
        },
        "volumes": {
          "maximum": 9999,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "fat",
        "format"
      ],
      "type": "object"
    },
    "fat-step.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "fat": {
          "$ref": "#/$defs/reference"
        },
        "format": {
          "enum": [
            "1.44M",
            "1.2M",
            "720K",
            "360K"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/line"
        },
        "order": {
          "enum": [
            "name",
            "listed"
          ]
        },
        "serial": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "$ref": "#/$defs/local-time"
        },
        "volumes": {
          "maximum": 9999,
          "minimum": 2,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "fat",
        "format"
      ],
      "type": "object"
    },
    "file-input": {
      "additionalProperties": false,
      "properties": {
        "bundle": {
          "type": "boolean"
        },
        "crc32": {
          "$ref": "#/$defs/crc32"
        },
        "disclosable": {
          "type": "boolean"
        },
        "ids": {
          "items": {
            "$ref": "#/$defs/db-id"
          },
          "type": "array"
        },
        "md5": {
          "$ref": "#/$defs/md5"
        },
        "name": {
          "$ref": "#/$defs/file-name"
        },
        "names": {
          "items": {
            "$ref": "#/$defs/line"
          },
          "type": "array"
        },
        "sha1": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "urls": {
          "items": {
            "$ref": "#/$defs/url"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "file-name": {
      "description": "a file name of at most 128 characters, without '/' or '\\', not '.' or '..'",
      "maxLength": 128,
      "not": {
        "anyOf": [
          {
            "pattern": "[/\\\\]"
          },
          {
            "enum": [
              ".",
              ".."
            ]
          }
        ]
      },
      "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
      "type": "string"
    },
    "file-set-entry": {
      "additionalProperties": false,
      "properties": {
        "disclosable": {
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "$ref": "#/$defs/local-time"
        }
      },
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "file-set-input": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/file-set-entry"
          },
          "minItems": 1,
          "type": "array"
        },
        "ids": {
          "items": {
            "$ref": "#/$defs/db-id"
          },
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/file-name"
        },
        "names": {
          "items": {
            "$ref": "#/$defs/line"
          },
          "type": "array"
        },
        "urls": {
          "items": {
            "$ref": "#/$defs/url"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "files"
      ],
      "type": "object"
    },
    "firmwarefile": {
      "else": {
        "$ref": "#/$defs/firmwarefile.any"
      },
      "if": {
        "properties": {
          "firmware": {
            "properties": {
              "platform": {
                "const": "ibm-pc"
              }
            },
            "required": [
              "platform"
            ]
          }
        },
        "required": [
          "firmware"
        ]
      },
      "then": {
        "$ref": "#/$defs/firmwarefile.ibm-pc"
      }
    },
    "firmwarefile.any": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "items": {
            "$ref": "#/$defs/attachment.any"
          },
          "type": "array"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.any"
          },
          "type": "array"
        },
        "firmware": {
          "$ref": "#/$defs/identity"
        },
        "ids": {
          "additionalProperties": {
            "$ref": "#/$defs/line128"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/file-set-input"
              },
              {
                "$ref": "#/$defs/file-input"
              }
            ]
          },
          "maxProperties": 4096,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "type": "object"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "package": {
          "$ref": "#/$defs/package.any"
        },
        "recipe": {
          "enum": [
            "1.0"
          ]
        },
        "rom": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rom-parts.any"
              },
              {
                "$ref": "#/$defs/rom-file.any"
              }
            ]
          },
          "type": "array"
        },
        "step": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/unpack-step"
              },
              {
                "$ref": "#/$defs/fat-step.any"
              },
              {
                "$ref": "#/$defs/text-step"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "recipe",
        "firmware"
      ],
      "type": "object"
    },
    "firmwarefile.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "items": {
            "$ref": "#/$defs/attachment.ibm-pc"
          },
          "type": "array"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.ibm-pc"
          },
          "type": "array"
        },
        "firmware": {
          "$ref": "#/$defs/identity"
        },
        "ids": {
          "additionalProperties": {
            "$ref": "#/$defs/line128"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/file-set-input"
              },
              {
                "$ref": "#/$defs/file-input"
              }
            ]
          },
          "maxProperties": 4096,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "type": "object"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "package": {
          "$ref": "#/$defs/package.ibm-pc"
        },
        "recipe": {
          "enum": [
            "1.0"
          ]
        },
        "rom": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rom-parts.ibm-pc"
              },
              {
                "$ref": "#/$defs/rom-file.ibm-pc"
              }
            ]
          },
          "type": "array"
        },
        "step": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/unpack-step"
              },
              {
                "$ref": "#/$defs/fat-step.ibm-pc"
              },
              {
                "$ref": "#/$defs/text-step"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "recipe",
        "firmware"
      ],
      "type": "object"
    },
    "fits.any": {
      "additionalProperties": false,
      "properties": {
        "boards": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "machine_classes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "fits.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "boards": {
          "items": {
            "enum": [
              "ibm-5170",
              "ibm-5150",
              "ibm-5160",
              "compaq-deskpro",
              "tandy-1000",
              "generic-386-isa",
              "i440fx-piix3",
              "i440bx-piix4"
            ]
          },
          "type": "array"
        },
        "machine_classes": {
          "items": {
            "enum": [
              "at",
              "xt"
            ]
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "id": {
      "description": "an id: lower-case letters, digits, '.', '_' and '-', starting with a letter or digit, at most 64 characters",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "min_app_version": {
          "$ref": "#/$defs/version"
        },
        "name": {
          "$ref": "#/$defs/repository"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "platform",
        "revision"
      ],
      "type": "object"
    },
    "license": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/spdx"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "terms": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "expression"
      ],
      "type": "object"
    },
    "line": {
      "description": "one line that is not blank, without control characters",
      "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
      "type": "string"
    },
    "line128": {
      "description": "one line of at most 128 characters that is not blank, without control characters",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$",
      "type": "string"
    },
    "local-time": {
      "description": "a local date-time with even seconds, years 1980 to 2107 (FAT and zip); TOML writes it unquoted, the JSON mapping makes it a string",
      "pattern": "^(198[0-9]|199[0-9]|20[0-9][0-9]|210[0-7])-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][02468]$",
      "type": "string"
    },
    "md5": {
      "description": "32 lower-case hexadecimal digits",
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "mediafile": {
      "else": {
        "$ref": "#/$defs/mediafile.any"
      },
      "if": {
        "properties": {
          "media": {
            "properties": {
              "platform": {
                "const": "ibm-pc"
              }
            },
            "required": [
              "platform"
            ]
          }
        },
        "required": [
          "media"
        ]
      },
      "then": {
        "$ref": "#/$defs/mediafile.ibm-pc"
      }
    },
    "mediafile.any": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "items": {
            "$ref": "#/$defs/attachment.any"
          },
          "type": "array"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.any"
          },
          "type": "array"
        },
        "ids": {
          "additionalProperties": {
            "$ref": "#/$defs/line128"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/file-set-input"
              },
              {
                "$ref": "#/$defs/file-input"
              }
            ]
          },
          "maxProperties": 4096,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "type": "object"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "media": {
          "$ref": "#/$defs/identity"
        },
        "medium": {
          "items": {
            "$ref": "#/$defs/medium.any"
          },
          "type": "array"
        },
        "needs": {
          "additionalProperties": {
            "oneOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,31}$",
                "type": "string"
              },
              {
                "items": {
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]{0,31}$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        "recipe": {
          "enum": [
            "1.0"
          ]
        },
        "step": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/unpack-step"
              },
              {
                "$ref": "#/$defs/fat-step.any"
              },
              {
                "$ref": "#/$defs/text-step"
              }
            ]
          },
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/title.any"
        },
        "work": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "recipe",
        "media"
      ],
      "type": "object"
    },
    "mediafile.ibm-pc": {
      "additionalProperties": false,
      "properties": {
        "attachment": {
          "items": {
            "$ref": "#/$defs/attachment.ibm-pc"
          },
          "type": "array"
        },
        "extra": {
          "items": {
            "$ref": "#/$defs/extra.ibm-pc"
          },
          "type": "array"
        },
        "ids": {
          "additionalProperties": {
            "$ref": "#/$defs/line128"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/file-set-input"
              },
              {
                "$ref": "#/$defs/file-input"
              }
            ]
          },
          "maxProperties": 4096,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "type": "object"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "media": {
          "$ref": "#/$defs/identity"
        },
        "medium": {
          "items": {
            "$ref": "#/$defs/medium.ibm-pc"
          },
          "type": "array"
        },
        "needs": {
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "oneOf": [
                {
                  "pattern": "^(8088|286|386|486|pentium)\\+?$",
                  "type": "string"
                },
                {
                  "items": {
                    "pattern": "^(8088|286|386|486|pentium)\\+?$",
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              ]
            },
            "ems": {
              "oneOf": [
                {
                  "pattern": "^[1-9][0-9]{0,6}[KM]$",
                  "type": "string"
                },
                {
                  "items": {
                    "pattern": "^[1-9][0-9]{0,6}[KM]$",
                    "type": "string"
                  },
                  "maxItems": 1,
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              ]
            },
            "fpu": {
              "oneOf": [
                {
                  "enum": [
                    "none",
                    "287",
                    "387"
                  ]
                },
                {
                  "items": {
                    "enum": [
                      "none",
                      "287",
                      "387"
                    ]
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              ]
            },
            "input": {
              "oneOf": [
                {
                  "enum": [
                    "mouse",
                    "joystick",
                    "none"
                  ]
                },
                {
                  "items": {
                    "enum": [
                      "mouse",
                      "joystick",
                      "none"
                    ]
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              ]
            },
            "memory": {
              "oneOf": [
                {
                  "pattern": "^[1-9][0-9]{0,6}[KM]$",
                  "type": "string"
                },
                {
                  "items": {
                    "pattern": "^[1-9][0-9]{0,6}[KM]$",
