      "description": "a relative path with '/' separators, without empty, '.' or '..' parts, '\\' or a drive",
      "not": {
        "anyOf": [
          {
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          {
            "pattern": "^[A-Za-z]:"
          }
        ]
      },
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+(/[^/\\\\\\u0000-\\u001f\\u007f]+)*$",
      "type": "string"
    },
    "platform": {
      "description": "a platform id: lower-case letters and digits, then also '-', '_' and '.', at most 64 characters",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "players": {
      "additionalProperties": false,
      "properties": {
        "max": {
